# Copy to ../.env (workspace) or .env (backend). Spring Boot loads it automatically.
# Use KEY=value without quotes or export. Keep the real API key out of source control.
AGENT_API_KEY=
AGENT_BASE_URL=https://api.deepseek.com
AGENT_COMPLETIONS_PATH=/chat/completions
AGENT_MODEL=deepseek-flash
# Non-thinking mode keeps tool calls compatible with the simple conversation history.
AGENT_REASONING_EFFORT=none
AGENT_DB_PATH=./data/agent.db
AGENT_HOST=127.0.0.1
AGENT_PORT=8080
AGENT_TIMEOUT_SECONDS=120
